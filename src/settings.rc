#pragma code_page(65001)
#include <windows.h>
#include <commctrl.h>
#include "settings_ids.h"

// Runtime layout uses the active monitor's DPI.
IDD_SETTINGS DIALOGEX 0, 0, 294, 496
STYLE DS_SETFONT | WS_POPUP | WS_THICKFRAME | WS_CLIPCHILDREN
// Buffer the entire child hierarchy, including native control state changes.
EXSTYLE WS_EX_TOOLWINDOW | WS_EX_TOPMOST | WS_EX_CONTROLPARENT | WS_EX_COMPOSITED
CAPTION "LayoutDock Settings"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "&Mode", IDC_MODE_LABEL, 0, 0, 10, 10, SS_CENTERIMAGE
    COMBOBOX IDC_MODE, 0, 0, 10, 60, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    LTEXT "M&onitor", IDC_MONITOR_LABEL, 0, 0, 10, 10, SS_CENTERIMAGE
    COMBOBOX IDC_MONITOR, 0, 0, 10, 90, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    LTEXT "&Horizontal", IDC_X_LABEL, 0, 0, 10, 10
    EDITTEXT IDC_OFFSET_X, 0, 0, 10, 18, ES_AUTOHSCROLL | WS_TABSTOP
    CONTROL "", IDC_SPIN_X, UPDOWN_CLASS, UDS_ALIGNRIGHT | UDS_SETBUDDYINT | UDS_ARROWKEYS | UDS_NOTHOUSANDS, 0, 0, 10, 18
    LTEXT "&Vertical", IDC_Y_LABEL, 0, 0, 10, 10
    EDITTEXT IDC_OFFSET_Y, 0, 0, 10, 18, ES_AUTOHSCROLL | WS_TABSTOP
    CONTROL "", IDC_SPIN_Y, UPDOWN_CLASS, UDS_ALIGNRIGHT | UDS_SETBUDDYINT | UDS_ARROWKEYS | UDS_NOTHOUSANDS, 0, 0, 10, 18
    PUSHBUTTON "Reset", IDC_RESET_POSITION, 0, 0, 10, 20
    LTEXT "", IDC_POSITION_HINT, 0, 0, 10, 26
    PUSHBUTTON "CapsLock", IDC_HOTKEY, 0, 0, 10, 24, BS_NOTIFY
    PUSHBUTTON "Reset", IDC_RESET_HOTKEY, 0, 0, 10, 24
    LTEXT "", IDC_HOTKEY_HINT, 0, 0, 10, 24
    CONTROL "Start with Windows", IDC_STARTUP, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 0, 0, 10, 14
    LISTBOX IDC_LAYOUTS, 0, 0, 10, 53, LBS_NOINTEGRALHEIGHT | LBS_NOSEL | WS_VSCROLL | WS_TABSTOP
    LTEXT "", IDC_ABOUT_VERSION, 0, 0, 10, 20, SS_CENTERIMAGE
    RTEXT "", IDC_ABOUT_AUTHOR, 0, 0, 10, 20, SS_CENTERIMAGE
    PUSHBUTTON "GitHub repository", IDC_REPOSITORY, 0, 0, 10, 20
    LTEXT "Changes are saved automatically.", IDC_SAVE_STATUS, 0, 0, 10, 24
    PUSHBUTTON "Quit LayoutDock", IDC_EXIT_APP, 0, 0, 10, 20
    PUSHBUTTON "Close", IDCANCEL, 0, 0, 10, 20
END
